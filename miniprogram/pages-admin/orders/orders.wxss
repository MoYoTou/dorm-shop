.refund-section { background: #fdecec; padding: 20rpx 0 4rpx; }
.refund-title { padding: 0 30rpx; color: #e64340; font-weight: 500; }
.refund-card { margin: 16rpx 20rpx; }
.tabs { white-space: nowrap; padding: 16rpx 20rpx; background: #fff; }
.tab { display: inline-block; padding: 12rpx 28rpx; margin-right: 12rpx; font-size: 26rpx; color: #666; border-radius: 32rpx; }
.tab.active { background: #07c160; color: #fff; }
.summary { margin: 12rpx 0; }
.ops { gap: 20rpx; margin-top: 20rpx; }
.mini { padding: 12rpx 28rpx; font-size: 24rpx; }
.modal-mask { position: fixed; inset: 0; background: rgba(0,0,0,.5); display: flex; align-items: center; justify-content: center; z-index: 99; }
.modal { width: 600rpx; background: #fff; border-radius: 16rpx; padding: 32rpx; }
.modal-title { font-weight: 500; margin-bottom: 20rpx; }
.modal textarea { width: 100%; height: 160rpx; background: #f7f7f7; border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; }
