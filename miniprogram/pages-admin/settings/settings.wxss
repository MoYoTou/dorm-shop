.sec-title { font-weight: 500; margin-bottom: 20rpx; font-size: 28rpx; }
.period { margin-bottom: 20rpx; }
.time-box { padding: 16rpx 32rpx; background: #f2f2f2; border-radius: 12rpx; font-size: 30rpx; }
.del { margin-left: auto; color: #e64340; font-size: 26rpx; }
.mini { display: inline-block; padding: 12rpx 28rpx; font-size: 24rpx; }
.field { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid #f2f2f2; }
.label { width: 180rpx; color: #666; }
.field input { flex: 1; }
textarea { width: 100%; height: 140rpx; background: #f7f7f7; border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; }
.footer { padding: 30rpx 20rpx 60rpx; }
