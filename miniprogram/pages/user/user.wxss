.profile { display: flex; align-items: center; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: #07c160; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 36rpx; margin-right: 24rpx; }
.nick { font-size: 32rpx; font-weight: 500; }
.sec-title { font-weight: 500; margin-bottom: 20rpx; }
.contact-row { gap: 24rpx; }
.cloud-warn { background: #fdecec; color: #e64340; font-size: 24rpx; padding: 16rpx; border-radius: 12rpx; margin-bottom: 20rpx; line-height: 1.7; }
.reset-btn { display: block; margin-top: 20rpx; color: #e64340; border-color: #e64340; }
.version { text-align: center; padding: 60rpx 0 40rpx; }
