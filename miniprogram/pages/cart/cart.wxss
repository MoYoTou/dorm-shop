.step-btn { width: 56rpx; height: 56rpx; border-radius: 12rpx; background: #f2f2f2; text-align: center; line-height: 56rpx; }
.qty { margin: 0 24rpx; }
.del { margin-left: 24rpx; color: #e64340; font-size: 26rpx; }
.footer { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: space-between; padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; }
.big { font-size: 40rpx; }
.checkout { padding: 0 60rpx; }
.go { display: inline-block; margin-top: 32rpx; }
