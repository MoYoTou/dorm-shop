.title { font-weight: 500; margin-bottom: 20rpx; }
.quick { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.chip { padding: 10rpx 24rpx; background: #f2f2f2; border-radius: 32rpx; font-size: 24rpx; color: #666; }
textarea { width: 100%; height: 180rpx; background: #f7f7f7; border-radius: 12rpx; padding: 16rpx; box-sizing: border-box; }
.tip { color: #999; font-size: 24rpx; line-height: 1.8; }
.footer { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; }
