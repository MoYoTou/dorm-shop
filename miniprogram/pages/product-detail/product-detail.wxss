.hero { width: 100%; height: 560rpx; }
.placeholder { background: #f0f0f0; color: #bbb; display: flex; align-items: center; justify-content: center; }
.name { font-size: 36rpx; font-weight: 500; }
.big { font-size: 44rpx; }
.stepper { display: flex; align-items: center; }
.step-btn { width: 60rpx; height: 60rpx; border-radius: 12rpx; background: #f2f2f2; text-align: center; line-height: 60rpx; font-size: 32rpx; }
.qty { margin: 0 32rpx; font-size: 32rpx; }
.footer { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 24rpx; padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom)); background: #fff; }
.footer .buy { flex: 1; }
.footer .disabled { background: #ccc; }
